+      //@note irq_fast_i[1] = GPIO bank 0 edge interrupt, irq_fast_i[8] = GPIO bank 1
+      //@note (mip bit 24), PapaBench patch (papabench_gpio.sv).
+    .irq_fast_i    ({6'b0, gpio1_irq, timer_e_irq, timer_d_irq, spi_s_irq, spi_m_irq,
+                     timer_b_irq, timer_a_irq, gpio_irq, uart_irq}),
     .irq_nm_i      (1'b0),
 
     .scramble_key_valid_i('0),
@@ -487,7 +506,9 @@
