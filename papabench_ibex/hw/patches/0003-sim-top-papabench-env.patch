Secure-Ibex SoC patch (PapaBench on Ibex): the Verilator top instantiates
papabench_env (hw/rtl/papabench_env.sv), which drives gp_i and uart_rx with
deterministic stimuli (radio PPM, modem clock, GPS UBX) selected by gp_o.
The UART DPI keeps receiving the UART TX (uart0.log) but no longer drives RX.
Applied by 'make sim' after 0002, to a copy under build/sim/hw/ (patch -p1).

--- a/rtl/top_simulation/reference_system.sv
+++ b/rtl/top_simulation/reference_system.sv
@@ -31,6 +31,9 @@
   //UART signals
   logic uart_rx;
   logic uart_tx;
+  // PapaBench-on-Ibex patch: uart_rx and gp_i come from the deterministic
+  // environment (papabench_env); the UART DPI only receives (uart0.log).
+  logic uart_dpi_tx_unused;
   //dmi signals
   logic        dmi_req_valid;
   logic        dmi_req_ready;
@@ -80,6 +83,14 @@
   assign  dmi_rsp_data=dmi_resp_debug_side.data;
   assign  dmi_rsp_resp=dmi_resp_debug_side.resp;
 
+  papabench_env u_papabench_env (
+    .clk_i     (clk_sys_i),
+    .rst_ni    (rst_sys_ni),
+    .gp_o_i    (gp_o),
+    .gp_i_o    (gp_i),
+    .uart_rx_o (uart_rx)
+  );
+
   //UART dpi interface
   uartdpi #(//@audit-info inizializzazione della uart nel simple-system
       .BAUD('d115_200),
@@ -89,7 +100,7 @@
       .clk_i          (clk_sys_i),
       .rst_ni         (rst_sys_ni),
       .active         (1'b1),
-      .tx_o           (uart_rx),
+      .tx_o           (uart_dpi_tx_unused),
       .rx_i           (uart_tx)
   );
   //Debugger dpi interface
