Secure-Ibex SoC patch (PapaBench on Ibex): PWM counter width becomes a
parameter of reference_system_core (default 8, as before) and the Verilator
top sets it to 20 bits, enough for a 20 ms servo period at 50 MHz.
Applied by 'make sim' first, to a copy under build/sim/hw/ (patch -p1); the
Secure-Ibex submodule itself is never modified.

--- a/rtl/system/reference_system_core.sv
+++ b/rtl/system/reference_system_core.sv
@@ -24,6 +24,9 @@
   parameter int GpiWidth     = 8,
   parameter int GpoWidth     = 16,
   parameter int PwmWidth     = 12,
+  //@note PapaBench-on-Ibex patch: PWM counter width is a parameter (was a
+  //@note localparam fixed at 8 bits); the default keeps the original width.
+  parameter int PwmCtrSize   = 8,
   parameter     SRAMInitFile = ""
 ) (
   input logic                 clk_sys_i,
@@ -92,7 +95,6 @@
   localparam logic [31:0] PWM_SIZE      =  4 * 1024; //  4 KiB
   localparam logic [31:0] PWM_START     = 32'h80003000;
   localparam logic [31:0] PWM_MASK      = ~(PWM_SIZE-1);
-  localparam int PwmCtrSize = 8;
 
   localparam logic [31:0] SPIM_SIZE     =  4 * 1024; //  4 KiB
   localparam logic [31:0] SPIM_START    = 32'h80004000;   // SPI master
--- a/rtl/top_simulation/reference_system.sv
+++ b/rtl/top_simulation/reference_system.sv
@@ -14,6 +14,9 @@
   parameter int GpiWidth     = 8,
   parameter int GpoWidth     = 16,
   parameter int PwmWidth     = 12,
+  // PapaBench-on-Ibex patch: 20-bit PWM counters, so that one period can
+  // span a 20 ms servo frame at 50 MHz (1,000,000 cycles < 2^20).
+  parameter int PwmCtrSize   = 20,
   parameter     SRAMInitFile = ""
 ) (
   input logic                 clk_sys_i,
@@ -51,6 +54,7 @@
     .GpiWidth(GpiWidth),
     .GpoWidth(GpoWidth),
     .PwmWidth(PwmWidth),
+    .PwmCtrSize(PwmCtrSize),
     .SRAMInitFile(SRAMInitFile)
   ) u_reference_system (
     //input
